{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nankai-tracker-logger",
  "main": "dist/worker.mjs",
  "compatibility_date": "2026-10-28",
  "workers_dev": true,
  "triggers": {
    "crons": [
      "* * * * *",
      "*/15 * * * *"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nankai-tracker-log",
      "database_id": "REPLACE_WITH_YOUR_DATABASE_ID"
    }
  ],
  "observability": {
    "enabled": true
  }
}
